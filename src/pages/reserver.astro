---
// src/pages/reserver.astro
import PageLayout from "../layouts/PageLayout.astro";
import BookingCalendar from "../components/BookingCalendar";
---

<PageLayout
  title="Réserver une excursion — Alizés Adventure"
  description="Réservez votre excursion dans la mangrove avec Alizés Adventure."
  heroTitle="Réserver une excursion"
  heroSubtitle="Choisissez votre date, votre créneau et le nombre de personnes."
  heroImage="/images/hero-mangrove.webp"
>
  <section id="reservation" class="relative isolate z-40 scroll-mt-28">
    <BookingCalendar client:only="react">
      <div slot="fallback" class="grid py-16">
        <div class="rounded-[28px] border border-slate-900/10 bg-white p-6 text-center shadow-2xl shadow-slate-900/10">
          <p class="font-black text-teal-700">
            Chargement du calendrier de réservation…
          </p>
          <p class="mt-2 text-sm text-slate-500">
            On prépare les bateaux, les dates, et deux-trois noix de coco.
          </p>
        </div>
      </div>
    </BookingCalendar>
  </section>

  <section class="mx-auto max-w-3xl py-20 text-center">
    <p class="mb-3 text-xs font-black uppercase tracking-[0.14em] text-teal-600">
      Comment ça marche ?
    </p>

    <h2 class="font-['Baloo_2'] text-[clamp(2.2rem,4vw,4rem)] font-extrabold leading-none text-slate-950">
      Le système calcule les bateaux nécessaires
    </h2>

    <p class="mt-6 leading-relaxed text-slate-600">
      Chaque bateau peut accueillir jusqu’à 4 personnes. Le système additionne le
      nombre d’adultes et d’enfants pour calculer automatiquement les bateaux
      nécessaires. Le prix est calculé selon le tarif de 50 € par adulte et 30 € par
      enfant. Le règlement se fait au départ de l’excursion, en espèces ou par
      chèque.
    </p>
  </section>
</PageLayout>