---
import BaseLayout from "./BaseLayout.astro";
import Hero from "../components/Hero.astro";

interface Props {
  title: string;
  description?: string;
  heroTitle?: string;
  heroSubtitle?: string;
  heroImage?: string;
  showHero?: boolean;
  wide?: boolean;
}

const {
  title,
  description,
  heroTitle = "",
  heroSubtitle,
  heroImage = "/images/hero-mangrove.webp",
  showHero = true,
  wide = false,
} = Astro.props;
---

<BaseLayout title={title} description={description}>
  {showHero && (
    <Hero title={heroTitle} subtitle={heroSubtitle} image={heroImage} />
  )}

  <main
    class:list={[
      "relative z-10 mx-auto overflow-visible",
      wide
        ? "w-[min(calc(100%-1rem),1400px)]"
        : "w-[min(calc(100%-1rem),1120px)]",
    ]}
  >
    <slot />
  </main>

  <div class="fixed bottom-4 left-1/2 z-999 -translate-x-1/2 rounded-full bg-red-600/80 px-4 py-2 text-center text-xs font-black uppercase tracking-[0.12em] text-white shadow-2xl shadow-slate-950/30 backdrop-blur-md max-sm:bottom-3 max-sm:w-[calc(100%-1.5rem)] max-sm:rounded-2xl">
    Prototype de démonstration
  </div>
</BaseLayout>