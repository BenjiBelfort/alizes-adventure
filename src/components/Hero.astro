---
interface Props {
  title: string;
  subtitle?: string;
  image?: string;
  eyebrow?: string;
}

const {
  title,
  subtitle,
  image = "/images/suivez-le-guide.webp",
  eyebrow = "Mangrove • Grand Cul-de-Sac Marin • Guadeloupe",
} = Astro.props;
---

<section class="relative isolate grid min-h-[78svh] place-items-center overflow-hidden">
  <img
    class="absolute inset-0 -z-30 h-full w-full object-cover"
    src={image}
    alt=""
    aria-hidden="true"
  />

  <div
    class="absolute inset-0 -z-20 bg-[radial-gradient(circle_at_50%_50%,rgba(15,159,154,.28),transparent_35%),linear-gradient(180deg,rgba(16,36,38,.36),rgba(16,36,38,.72))]"
  >
  </div>

  <div class="w-[min(calc(100%-2rem),980px)] px-0 pb-24 pt-40 text-center">
    <p class="mb-3 text-xs font-black uppercase tracking-[0.14em] text-yellow-300">
      {eyebrow}
    </p>

    <h1 class="mx-auto max-w-5xl text-balance font-['Baloo_2'] text-[clamp(3.2rem,8vw,6.8rem)] font-extrabold leading-[.92] text-white">
      {title}
    </h1>

    {subtitle && (
      <p class="mx-auto mt-5 max-w-3xl text-[clamp(1.05rem,2vw,1.35rem)] font-semibold leading-relaxed text-white/90">
        {subtitle}
      </p>
    )}

    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a
        href="/reserver#reservation"
        class="inline-flex min-h-12 items-center justify-center rounded-full bg-teal-500 px-6 py-3 font-black text-white no-underline shadow-2xl shadow-teal-700/25 transition hover:-translate-y-0.5 hover:bg-teal-600"
      >
        Réserver une excursion
      </a>

      <a
        href="/votre-excursion"
        class="inline-flex min-h-12 items-center justify-center rounded-full border border-white/35 bg-white/15 px-6 py-3 font-black text-white no-underline backdrop-blur-sm transition hover:-translate-y-0.5 hover:bg-white/25"
      >
        Découvrir le parcours
      </a>
    </div>
  </div>
</section>